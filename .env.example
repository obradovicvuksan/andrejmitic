# Javni URL sajta (koristi se za Keystatic OAuth povratni link u produkciji)
NEXT_PUBLIC_SITE_URL=https://andrejmitic.rs

# ── Keystatic (blog admin na /keystatic) ──
# Lokalno (npm run dev) ništa ne morate da podešavate: objave se čuvaju u content/blog.
# U produkciji (npm run build / Netlify) admin automatski koristi GitHub prijavu i čuva objave
# kao commit u repozitorijum. Može se pregaziti sa NEXT_PUBLIC_KEYSTATIC_STORAGE=local|github.
KEYSTATIC_GITHUB_REPOSITORY=obradovicvuksan/andrejmitic
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Opciono: dodatna lozinka (Basic Auth) ispred /keystatic, pored GitHub prijave.
KEYSTATIC_USERNAME=
KEYSTATIC_PASSWORD=
